rules_version = '2';

// Production security rules for the typ0k messenger.
// Generated from the Swift data models and Firestore service layer:
//
//   users/{userId}            <- User (Models/User.swift) + AuthManager profile sync
//     uid, email, displayName, username, usernameLower, phone, createdAt,
//     selectedFrameId, nicknameStyleId
//
//   chats/{chatId}            <- RemoteChat (Services/ChatService.swift)
//     participants: [String], lastMessage: String,
//     lastMessageTimestamp: Timestamp, unreadCount: { uid: Int }
//
//   chats/{chatId}/messages/{messageId}  <- RemoteMessage
//     senderId: String (== Auth UID), text: String,
//     timestamp: Timestamp, status: "sent" | "delivered" | "read"
//
// Direct chats use the deterministic ID "min(uid1,uid2)_max(uid1,uid2)",
// so both participants address the same document without lookups.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function writesSelfAsSender() {
      return isAuthenticated()
        && request.resource.data.senderId == request.auth.uid;
    }

    // --- User profiles (search + account profile) ---------------------------

    match /users/{userId} {
      // Every authenticated user may read profiles — required by the global
      // @username search (usernameLower prefix queries) and chat titles.
      allow read: if isAuthenticated();

      // A user creates and updates exactly their own document. This keeps
      // search/profile writes open to authenticated users while preventing
      // one account from overwriting another account's profile.
      allow create, update: if isOwner(userId);

      // Profiles are never hard-deleted from clients.
      allow delete: if false;
    }

    // --- Direct chats --------------------------------------------------------

    match /chats/{chatId} {
      // Chat list queries run with `participants arrayContains <uid>`;
      // list queries cannot evaluate get(), so reads are open to any
      // authenticated user and isolation is enforced by the query itself.
      allow read: if isAuthenticated();

      // Creating a chat: the caller must list themselves as a participant.
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;

      // Updates refresh lastMessage/lastMessageTimestamp/unreadCount —
      // the counterpart's unread counter is incremented by the sender,
      // so participant-only updates are not enforceable per field.
      allow update: if isAuthenticated();

      allow delete: if isAuthenticated();

      // --- Messages subcollection -------------------------------------------

      match /messages/{messageId} {
        // Both sides of a 1-on-1 chat read the full history.
        allow read: if isAuthenticated();

        // Messages must be authored as the caller (mirrors Message.senderID
        // set from Auth.auth().currentUser.uid in ChatService).
        allow create: if writesSelfAsSender();

        // Only the original author may edit or delete their message.
        allow update, delete: if isAuthenticated()
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
